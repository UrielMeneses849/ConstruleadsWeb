# En desarrollo: http://localhost:8000
# En producción se recomienda dejarlo vacío y publicar /api detrás del mismo dominio.
VITE_FICHA_API_URL=http://localhost:8000

# Clave pública del SDK web. Debe configurarse en el entorno de build y estar
# restringida en Google Cloud por dominio y por Maps JavaScript API.
VITE_GOOGLE_MAPS_API_KEY=your_restricted_browser_key
