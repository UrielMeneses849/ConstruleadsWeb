  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "cp dist/index.html dist/404.html",
    "build:test": "vite build --mode test --outDir dist-test",
    "postbuild:test": "cp dist-test/index.html dist-test/404.html",
    "preview:test": "vite preview --outDir dist-test",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
